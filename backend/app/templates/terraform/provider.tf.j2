terraform {
  required_version = ">= 1.6.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = "{{ target_region }}"
}

# Source region provider alias (used for data sources during migration)
provider "aws" {
  alias  = "source"
  region = "{{ source_region }}"
}
