# ── Google ADC ───────────────────────────────────────────────────────────────
# If using a service account key file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json
# Otherwise `gcloud auth application-default login` sets ADC automatically.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# ── AWS credentials (boto3 / SigV4 auth — NOT OAuth) ─────────────────────────
# Option A: Use IAM role / instance profile (preferred in prod — no keys needed)
# Option B: Named profile
AWS_PROFILE=default
AWS_DEFAULT_REGION=ap-south-1

# Option C: Explicit keys (dev only — do NOT commit)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# ── App settings ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SESSIONS_DIR=./sessions
